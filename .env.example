# Entorno: development | production
APP_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080

# Formato del driver Go. Easypanel entrega host, usuario y clave en Credentials.
# Agrega parseTime=true y loc=UTC. La base debe llamarse crm.
DATABASE_DSN=usuario:REEMPLAZA_CLAVE@tcp(host-mysql:3306)/crm?parseTime=true&loc=UTC&charset=utf8mb4

# Minimo 32 caracteres. Firma cookies y otros valores internos.
AUTH_SECRET=REEMPLAZA_CON_UN_SECRETO_DE_32_CARACTERES

# Exactamente 32 bytes en base64. Se usara para secretos de canales.
ENCRYPTION_KEY=REEMPLAZA_CON_32_BYTES_EN_BASE64

SESSION_HOURS=168
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# WhatsApp y Meta se configuran desde Ajustes dentro de Nexora.
# El token, App Secret, WABA ID y Phone Number ID no se guardan en variables.
# El webhook y su verify token se generan automaticamente por organizacion.
# Solo para arneses locales; en produccion se conserva Graph por defecto.
# META_GRAPH_BASE_URL=https://graph.facebook.com
# Transporte opcional para Instagram, Messenger y TikTok. Normalmente no se
# cambia; sirve para instalaciones con un endpoint Zernio compatible.
ZERNIO_BASE_URL=https://zernio.com/api/v1

# Integracion futura con el cerebro externo. Tambien se movera a Ajustes.
BOT_API_KEY=
BRAIN_DISPATCH_URL=
BRAIN_HEALTH_URL=
MEDIA_DIR=/data/media
