# Entorno: development | production
APP_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080

# Formato del driver Go. Easypanel entrega host, usuario y clave en Credentials.
# Agrega parseTime=true y loc=UTC. La base debe llamarse crm.
DATABASE_DSN=usuario:REEMPLAZA_CLAVE@tcp(host-mysql:3306)/crm?parseTime=true&loc=UTC&charset=utf8mb4

# Minimo 32 caracteres. Firma cookies y otros valores internos.
AUTH_SECRET=REEMPLAZA_CON_UN_SECRETO_DE_32_CARACTERES

# Exactamente 32 bytes en base64. Se usara para secretos de canales.
ENCRYPTION_KEY=REEMPLAZA_CON_32_BYTES_EN_BASE64

SESSION_HOURS=168
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_MINUTES=30

# Integraciones futuras. Vacias = apagadas.
META_WEBHOOK_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
BOT_API_KEY=
BRAIN_DISPATCH_URL=
BRAIN_HEALTH_URL=
MEDIA_DIR=/data/media
